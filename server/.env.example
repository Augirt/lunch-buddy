# 在百炼华北2（北京）创建 API Key；只在服务端读取。
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3.8-flash

# 北京旧域名仍可用；推荐替换为业务空间专属地址：
# https://你的业务空间ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

HOST=127.0.0.1
PORT=3000
MODEL_TIMEOUT_MS=8000
REQUEST_TIMEOUT_MS=9000
# 前端完成V2契约接入并独立验收后启用；默认保持旧接口行为
AGENT_V2_ENABLED=false
MODEL_MAX_TOKENS=600
